# --- Python (validator, hooks, and tests are stdlib Python) ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
*.egg-info/
.venv/
venv/
env/

# --- Installer artifacts ---
# install.sh / install.ps1 back up existing files as <name>.backup.<timestamp>
# before overwriting. Never commit those.
*.backup.*

# --- Claude Code runtime state ---
# AGENTS.md is explicit: Claude Code owns team/task state locally; it must not
# be versioned or hand-edited. Keep .claude/agents and .claude/settings.json
# committable (they are configuration), ignore everything generated.
.claude/settings.local.json
.claude/teams/
.claude/tasks/
.claude/state/
.claude/history/
.claude/todos/
.claude/shell-snapshots/
.claude/statsig/
.claude/projects/
.claude/logs/
.claude/*.log
# Per-agent memory written by the roles as they work: local runtime state, not
# configuration. It was ignored only through .git/info/exclude, which does not
# travel with the repository - a fresh clone would have started versioning it.
.claude/agent-memory-local/

# --- Local, machine-specific settings ---
# settings.example.json is the versioned template; a real settings.json with
# absolute hook paths is machine-specific.
settings.local.json

# --- Editors / IDEs ---
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# --- OS cruft ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# --- Scratch ---
tmp/
temp/
scratch/
*.tmp
*.orig
*.rej

# CI installer sandbox (hermetic HOME for installer tests)
.testhome/

# Local scratch used by tests/test-hooks.py (must live outside the system temp dir)
.tmp-pycheck/
