{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/claude-code/handoff.schema.json",
  "title": "Claude Code Agent Handoff",
  "description": "Versioned structured handoff emitted as the final message of every specialist agent. The lead treats this object as the interface; free-text outside the JSON is ignored for gating.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handoff_id",
    "from_role",
    "to",
    "task_id",
    "status",
    "confidence",
    "summary",
    "timestamp",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0",
      "description": "Handoff contract version. Bump only on breaking field changes."
    },
    "handoff_id": {
      "type": "string",
      "minLength": 8,
      "description": "Unique id for this handoff (UUID or short trace id). Correlate parallel workstreams."
    },
    "from_role": {
      "type": "string",
      "enum": [
        "architect",
        "researcher",
        "implementer",
        "debugger",
        "tester",
        "reviewer",
        "security-reviewer",
        "lead"
      ]
    },
    "to": {
      "type": "string",
      "description": "Intended recipient: usually 'lead', or another role name when chaining."
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable id of the work item (matches shared task list when present)."
    },
    "status": {
      "type": "string",
      "enum": ["done", "blocked", "needs_review", "failed", "plan_ready"],
      "description": "Terminal state of this agent's work on the task."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Agent's calibrated confidence in the handoff claims (0–1)."
    },
    "summary": {
      "type": "string",
      "minLength": 10,
      "description": "One or two sentences. MUST include a proof token: commit SHA, test count, file:line, or command that passed."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC time the handoff was produced."
    },
    "payload": {
      "type": "object",
      "description": "Role-specific body. Shape depends on from_role; see orchestration/handoff.md.",
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "from_role": {
            "const": "implementer"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "result",
              "owned_scope",
              "files_changed",
              "files_off_limits_touched",
              "validation",
              "tests_added_or_updated",
              "risks",
              "integration_notes",
              "rejected_approaches"
            ],
            "properties": {
              "owned_scope": {"type": "array"},
              "files_changed": {"type": "array"},
              "files_off_limits_touched": {"type": "array"},
              "validation": {"type": "array"},
              "tests_added_or_updated": {"type": "array"},
              "risks": {"type": "array"},
              "integration_notes": {"type": "array"},
              "rejected_approaches": {"type": "array"}
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "from_role": {
            "const": "debugger"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "result",
              "failure",
              "reproduction",
              "root_cause",
              "fix",
              "owned_scope",
              "files_changed",
              "files_off_limits_touched",
              "validation",
              "tests_added_or_updated",
              "risks",
              "integration_notes",
              "rejected_approaches"
            ],
            "properties": {
              "owned_scope": {"type": "array"},
              "files_changed": {"type": "array"},
              "files_off_limits_touched": {"type": "array"},
              "validation": {"type": "array"},
              "tests_added_or_updated": {"type": "array"},
              "risks": {"type": "array"},
              "integration_notes": {"type": "array"},
              "rejected_approaches": {"type": "array"}
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "from_role": {
            "const": "tester"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "coverage_assessment",
              "tests_added",
              "validation",
              "findings",
              "recommendation"
            ],
            "properties": {
              "tests_added": {"type": "array"},
              "validation": {"type": "array"},
              "findings": {"type": "array"}
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "from_role": {
            "const": "reviewer"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "posture",
              "findings",
              "positive_controls",
              "residual_risk"
            ],
            "properties": {
              "findings": {"type": "array"},
              "positive_controls": {"type": "array"}
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "from_role": {
            "const": "security-reviewer"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "posture",
              "findings",
              "positive_controls",
              "residual_risk"
            ],
            "properties": {
              "findings": {"type": "array"},
              "positive_controls": {"type": "array"}
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "from_role": {
            "const": "architect"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "understanding",
              "change_surface",
              "dependencies",
              "parallelization",
              "risks",
              "recommendation",
              "task_breakdown"
            ],
            "properties": {
              "change_surface": {"type": "array"},
              "dependencies": {"type": "array"},
              "parallelization": {"type": "array"},
              "risks": {"type": "array"},
              "task_breakdown": {"type": "array"}
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "from_role": {
            "const": "researcher"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "question",
              "findings",
              "options",
              "recommendation",
              "caveats"
            ],
            "properties": {
              "findings": {"type": "array"},
              "options": {"type": "array"},
              "caveats": {"type": "array"}
            },
            "additionalProperties": true
          }
        }
      }
    }
  ]
}
